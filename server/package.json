{
  "name": "@otago/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome format --write .",
    "test": "vitest run",
    "ask": "tsx scripts/ask.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@fastify/multipart": "^10.1.2",
    "dotenv": "^18.0.3",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "turndown": "^7.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
